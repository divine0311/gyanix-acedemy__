{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "PORT=${PORT:-5000} BASE_PATH=${BASE_PATH:-/} npm run --prefix artifacts/gyanix-academy dev",
    "build": "PORT=${PORT:-5000} BASE_PATH=${BASE_PATH:-/} npm run --prefix artifacts/gyanix-academy build",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@rollup/rollup-win32-x64-msvc": "^4.62.5",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
