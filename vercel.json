{
  "buildCommand": "PORT=5000 BASE_PATH=/ npx --yes pnpm@12.5.1 --filter @workspace/gyanix-academy run build",
  "outputDirectory": "dist/public",
  "installCommand": "npx --yes pnpm@12.5.1 install",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gyanix-acedemy.onrender.com/api/:path*"
    }
  ]
}
